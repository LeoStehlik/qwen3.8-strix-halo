+// Same SwiGLU/int8 layout as gu_epilogue, with eight lanes cooperating on each
+// 32-feature quantization group. All 256 threads process four features each,
+// rather than 32 threads holding 32 values each. Max and integer sum reductions
+// do not reorder the floating-point products or the matrix accumulation.
+template <int BN>
+__device__ __forceinline__ void gu_epilogue_cooperative(const v8f (&acc)[BN / 16], uint8_t* lds, int tid,
+                                                       int live_tiles, int nrows, int row0, int fb,
+                                                       uint8_t* __restrict__ out) {
+#if STRATA_F16_DEVICE
+    const int wave = tid >> 5, lane = tid & 31, sub_lane = lane & 15, half_id = lane >> 4;
+    float* base = reinterpret_cast<float*>(lds);
+    float* scratch = base + wave * GU_EPI_PLANE;
+    const int t = tid >> 4, f0 = (tid & 15) * 4, hh = (tid >> 3) & 1;
+#pragma unroll
+    for (int j = 0; j < BN / 16; ++j) {
+        if (j >= live_tiles) break;
+#pragma unroll
+        for (int l = 0; l < 8; ++l) scratch[sub_lane * GU_EPI_STRIDE + 2 * l + half_id] = acc[j][l];
+        __syncthreads();
+        const int r = j * 16 + t;
+        if (r < nrows) {
+            float hv[4];
+            float am = 0.0f;
+#pragma unroll
+            for (int f = 0; f < 4; ++f) {
+                const int ft = f0 + f;
+                const int idx = (ft >> 4) * GU_EPI_PLANE + t * GU_EPI_STRIDE + (ft & 15);
+                const float gt = base[idx], up = base[idx + 4 * GU_EPI_PLANE];
+                hv[f] = gt / (1.0f + __expf(-gt)) * up;
+                am = fmaxf(am, fabsf(hv[f]));
+            }
+#pragma unroll
+            for (int shift = 1; shift < 8; shift <<= 1)
+                am = fmaxf(am, __shfl_xor_sync(0xffffffffu, am, shift, 8));
+            const float inv = am > 0.0f ? 127.0f / am : 0.0f;
+            uint32_t wd = 0;
+            int csum = 0;
+#pragma unroll
+            for (int f = 0; f < 4; ++f) {
+                const int c = __float2int_rn(hv[f] * inv);
+                csum += c;
+                wd |= (uint32_t) (uint8_t) (int8_t) c << (8 * f);
+            }
+#pragma unroll
+            for (int shift = 1; shift < 8; shift <<= 1)
+                csum += __shfl_xor_sync(0xffffffffu, csum, shift, 8);
+            uint8_t* o = out + (size_t) (row0 + r) * H_LD + (size_t) fb * AB;
+            *reinterpret_cast<uint32_t*>(o + f0) = wd;
+            if ((tid & 7) == 0) {
+                *reinterpret_cast<float*>(o + 64 + 4 * hh) = am / 127.0f;
+                *reinterpret_cast<float*>(o + 72 + 4 * hh) = (float) csum;
+            }
+        }
+        __syncthreads();
+    }
+#else
+    (void) acc; (void) lds; (void) tid; (void) live_tiles; (void) nrows; (void) row0; (void) fb; (void) out;
+    __builtin_trap();
+#endif
+}
