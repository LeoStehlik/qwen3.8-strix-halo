diff --git a/tests/hip/pa_native_i8.cpp b/tests/hip/pa_native_i8.cpp
new file mode 100644
index 0000000..a00d2db
--- /dev/null
+++ b/tests/hip/pa_native_i8.cpp
@@ -0,0 +1,69 @@
+// All 65,536 ordered byte pairs at every aligned pair position of a 16-code
+// fragment. CPU expected half bits are built with integer arithmetic.
+#include "../../src/kernels/cuda/hip_native_i8_half.cuh"
+#include <hip/hip_runtime.h>
+#include <cstdio>
+#include <cstring>
+#include <vector>
+
+#define CK(call) do { const hipError_t e = (call); if (e != hipSuccess) { \
+    std::fprintf(stderr, "%s: %s\n", #call, hipGetErrorString(e)); return 1; } } while (0)
+
+__global__ void decode_pairs(uint16_t* out) {
+    const uint32_t pair = blockIdx.x * blockDim.x + threadIdx.x;
+    if (pair >= 65536) return;
+    uint32_t words[4];
+#pragma unroll
+    for (int j = 0; j < 4; ++j)
+        words[j] = ((pair + 997u * j) & 65535u) | (((pair ^ (0xa55au + 251u * j)) & 65535u) << 16);
+    const auto h = strata::kernels::hip_detail::native_i8_to_half16(words);
+#pragma unroll
+    for (int i = 0; i < 16; ++i) {
+        const _Float16 scalar = h[i];
+        out[(size_t) pair * 16 + i] = __builtin_bit_cast(uint16_t, scalar);
+    }
+}
+
+static uint16_t integer_half_bits(int value) {
+    if (value == 0) return 0;
+    const uint16_t sign = value < 0 ? 0x8000 : 0;
+    const unsigned magnitude = value < 0 ? (unsigned) -value : (unsigned) value;
+    int exponent = 0;
+    while ((1u << (exponent + 1)) <= magnitude) ++exponent;
+    return sign | (uint16_t) ((exponent + 15) << 10) |
+           (uint16_t) ((magnitude - (1u << exponent)) << (10 - exponent));
+}
+
+int main() {
+    hipDeviceProp_t prop{};
+    CK(hipGetDeviceProperties(&prop, 0));
+    if (std::strncmp(prop.gcnArchName, "gfx11", 5) != 0) return 77;
+    constexpr size_t count = 65536 * 16;
+    uint16_t* output = nullptr;
+    CK(hipMalloc(&output, (count + 32) * sizeof(uint16_t)));
+    CK(hipMemset(output, 0xa5, (count + 32) * sizeof(uint16_t)));
+    decode_pairs<<<256, 256>>>(output);
+    CK(hipGetLastError());
+    CK(hipDeviceSynchronize());
+    std::vector<uint16_t> actual(count + 32);
+    CK(hipMemcpy(actual.data(), output, actual.size() * sizeof(uint16_t), hipMemcpyDeviceToHost));
+    for (uint32_t pair = 0; pair < 65536; ++pair) for (int j = 0; j < 4; ++j) {
+        const uint32_t word = ((pair + 997u * j) & 65535u) |
+                             (((pair ^ (0xa55au + 251u * j)) & 65535u) << 16);
+        for (int byte = 0; byte < 4; ++byte) {
+            const unsigned code = (word >> (byte * 8)) & 255u;
+            const int signed_value = code < 128 ? (int) code : (int) code - 256;
+            const size_t at = (size_t) pair * 16 + j * 4 + byte;
+            if (actual[at] != integer_half_bits(signed_value)) {
+                std::fprintf(stderr, "pair=%u position=%d code=%u actual=%04x expected=%04x\n",
+                             pair, j * 4 + byte, code, actual[at], integer_half_bits(signed_value));
+                return 1;
+            }
+        }
+    }
+    for (size_t i = count; i < actual.size(); ++i) if (actual[i] != 0xa5a5) return 1;
+    CK(hipFree(output));
+    std::printf("PASS: %zu exact conversions; all 65536 byte pairs in all 8 pair positions; guard intact (%s)\n",
+                count, prop.gcnArchName);
+    return 0;
+}
