+void prepare_weights_f16_native(const Batch& b, const NativeGeom& g, void* gu, void* down, void* stream) {
+#if defined(__HIPCC__)
+    if (g.gu_type != GGML_TYPE_Q4_K || g.d_type != GGML_TYPE_Q5_1) std::abort();
+    f16kq::prepare_weights(b, g, gu, down, (cudaStream_t) stream);
+    ck(cudaGetLastError(), "prepare_weights_f16_native");
+#else
+    (void) b; (void) g; (void) gu; (void) down; (void) stream;
+    std::abort();
+#endif
+}
+
+void experts_native_weights(const Batch& b, const NativeGeom& g, int n_expert, int64_t n,
+                            const void* scratch, const void* xa, const int32_t* src, void* ha,
+                            float* dm, const void* gu_weights, const void* down_weights, void* stream) {
+#if defined(__HIPCC__)
+    if (b.e1 <= b.e0 || n <= 0) return;
+    const DevInfo& d = dev_info();
+    if (!d.ok || d.w12 || !f16::requested() || g.gu_type != GGML_TYPE_Q4_K || g.d_type != GGML_TYPE_Q5_1)
+        std::abort();
+    const cudaStream_t s = (cudaStream_t) stream;
+    const Tables tb = tables(const_cast<void*>(scratch), n_expert);
+    const int64_t bound = (n + kTileRows - 1) / kTileRows + (b.e1 - b.e0);
+    if (gu_weights)
+        f16kq::weights_gate_up(b, tb.ts, tb.tiles, tb.off, n, n_expert, bound, gu_weights,
+                               (const uint8_t*) xa, src, (uint8_t*) ha, s);
+    else
+        f16kq::gate_up(b, g, tb.ts, tb.tiles, tb.off, n, n_expert, bound,
+                      (const uint8_t*) xa, src, (uint8_t*) ha, s);
+    if (down_weights)
+        f16kq::weights_down(b, tb.ts, tb.tiles, tb.off, n, n_expert, bound, down_weights,
+                           (const uint8_t*) ha, dm, s);
+    else
+        f16kq::down(b, g, tb.ts, tb.tiles, tb.off, n, n_expert, bound, (const uint8_t*) ha, dm, s);
+    ck(cudaGetLastError(), "experts_native_weights");
+#else
+    (void) b; (void) g; (void) n_expert; (void) n; (void) scratch; (void) xa; (void) src;
+    (void) ha; (void) dm; (void) gu_weights; (void) down_weights; (void) stream;
+    std::abort();
+#endif
+}
