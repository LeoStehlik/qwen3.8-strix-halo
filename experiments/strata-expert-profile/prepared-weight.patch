+#include "moe_f16_kq.hpp"
+#include "moe_f16_common.cuh"
+#include <algorithm>
+
+namespace strata::prefill::fused::f16kq {
+namespace {
+using namespace f16;
+
+// The same separately rounded scale/bias and half FMA used by the quantized
+// kernels. All codes 0..31 are exactly representable as half values.
+template <bool GU>
+__global__ void expand_weights_kernel(Batch b, NativeGeom g, __half2* output) {
+#if STRATA_F16_DEVICE
+    constexpr int COLS = GU ? 2560 : 640, NROWS = GU ? 1280 : 2560;
+    const int chunk = (int) blockIdx.x * blockDim.x + threadIdx.x;
+    if (chunk >= NROWS * (COLS / 32)) return;
+    const int e = b.e0 + (int) blockIdx.y, row = chunk / (COLS / 32), k32 = chunk % (COLS / 32);
+    const uint8_t* base = b.blob[e - b.e0];
+    __half2 scale2, bias2;
+    const uint8_t* codes;
+    uint32_t high = 0;
+    int shift = 0;
+    if constexpr (GU) {
+        const uint8_t* block = base + (row >= 640 ? g.up_off : 0) + (size_t) (row % 640) * g.gu_row + (k32 / 8) * 144;
+        const int sb = k32 % 8;
+        const unsigned sc = sb < 4 ? block[4 + sb] & 63u : (block[8 + sb] & 15u) | ((block[sb] >> 6) << 4);
+        const unsigned mn = sb < 4 ? block[8 + sb] & 63u : (block[8 + sb] >> 4) | ((block[4 + sb] >> 6) << 4);
+        const __half2 dm = *reinterpret_cast<const __half2*>(block);
+        const float scale = __low2float(dm) * (float) sc, offset = __high2float(dm) * (float) mn;
+        const __half2 sb2 = __floats2half2_rn(scale, -offset);
+        scale2 = __low2half2(sb2); bias2 = __high2half2(sb2);
+        codes = block + 16 + (sb / 2) * 32;
+        shift = 4 * (sb & 1);
+    } else {
+        const uint8_t* block = base + g.down_off + (size_t) row * g.d_row + k32 * 24;
+        const __half2 dm = *reinterpret_cast<const __half2*>(block);
+        scale2 = __low2half2(dm); bias2 = __high2half2(dm);
+        // Blocks need only 2-byte alignment in the reference fixture.
+        __builtin_memcpy(&high, block + 4, sizeof(high));
+        codes = block + 8;
+    }
+    __half2* dst = output + ((size_t) e * NROWS * COLS + (size_t) chunk * 32) / 2;
+#pragma unroll
+    for (int j = 0; j < 16; ++j) {
+        const int i0 = 2 * j, i1 = i0 + 1;
+        unsigned q0, q1;
+        if constexpr (GU) {
+            q0 = (codes[i0] >> shift) & 15u;
+            q1 = (codes[i1] >> shift) & 15u;
+        } else {
+            q0 = ((codes[i0 & 15] >> (4 * (i0 >> 4))) & 15u) | (((high >> i0) & 1u) << 4);
+            q1 = ((codes[i1 & 15] >> (4 * (i1 >> 4))) & 15u) | (((high >> i1) & 1u) << 4);
+        }
+        dst[j] = __hfma2(__floats2half2_rn((float) q0, (float) q1), scale2, bias2);
+    }
+#else
+    (void) b; (void) g; (void) output; __builtin_trap();
+#endif
+}
+
+// F16 weights are loaded directly into the WMMA operands. Only activations use
+// LDS; the quantized activation layout and the accumulation/epilogue stay unchanged.
+template <bool GU, int BN>
+__global__ void __launch_bounds__(THREADS)
+weights_kernel(Batch b, const int32_t* ts, const int2* tiles, const int32_t* off,
+               const uint4* weights, const uint8_t* act, const int32_t* src, uint8_t* out, float* dm) {
+#if STRATA_F16_DEVICE
+    constexpr int COLS = GU ? 2560 : 640, NROWS = GU ? 1280 : 2560;
+    constexpr int NFB = GU ? GU_NFB : D_NFB;
+    constexpr int EPI = GU ? GU_EPI_BYTES : D_EPI_BYTES;
+    constexpr int LDS_BYTES = ActStage<BN>::BYTES > EPI ? ActStage<BN>::BYTES : EPI;
+    __shared__ __attribute__((aligned(16))) uint8_t lds[LDS_BYTES];
+    __shared__ int srow[BN];
+    const int tid = threadIdx.x, wave = tid >> 5, sub_lane = tid & 15;
+    int fb, e, row0, nrows;
+    if (!work_item<BN, NFB>(b, ts, tiles, off, blockIdx.x, fb, e, row0, nrows)) return;
+    if (tid < BN) srow[tid] = tid < nrows ? (GU ? src[row0 + tid] : row0 + tid) : -1;
+    __syncthreads();
+    const int wr = GU ? fb * 64 + (wave % 4) * 16 + sub_lane + (wave >= 4 ? 640 : 0)
+                      : fb * ROWS + wave * 16 + sub_lane;
+    const uint4* wrow = weights + ((size_t) e * NROWS * COLS + (size_t) wr * COLS) / 8;
+    const int live_tiles = (nrows + 15) / 16;
+    ActStage<BN> as;
+    as.init(act, GU ? GU_ACT_LD : H_LD, srow, tid);
+    auto* s_act = reinterpret_cast<uint4*>(lds);
+    v8f acc[BN / 16];
+#pragma unroll
+    for (int j = 0; j < BN / 16; ++j) acc[j] = v8f{0, 0, 0, 0, 0, 0, 0, 0};
+    as.fetch(0);
+    for (int s = 0; s < COLS / 64; ++s) {
+        as.commit(s_act);
+        __syncthreads();
+        if (s + 1 < COLS / 64) as.fetch(s + 1);
+#pragma unroll
+        for (int kb = 0; kb < 2; ++kb) {
+            const uint4* wp = wrow + s * 8 + kb * 4;
+            const uint4 raw[4] = {wp[0], wp[1], wp[2], wp[3]};
+            v16h lo, hi;
+            __builtin_memcpy(&lo, &raw[0], 32);
+            __builtin_memcpy(&hi, &raw[2], 32);
+            mma_tiles<BN>(acc, lo, hi, s_act, kb, sub_lane, live_tiles);
+        }
+        __syncthreads();
+    }
+    if constexpr (GU) gu_epilogue<BN>(acc, lds, tid, live_tiles, nrows, row0, fb, out);
+    else down_epilogue<BN>(acc, lds, tid, live_tiles, nrows, row0, fb, dm);
+#else
+    (void) b; (void) ts; (void) tiles; (void) off; (void) weights; (void) act;
+    (void) src; (void) out; (void) dm; __builtin_trap();
+#endif
+}
+} // namespace
+
+void prepare_weights(const Batch& b, const NativeGeom& g, void* gu, void* down, cudaStream_t s) {
+    if (b.e1 <= b.e0) return;
+    if (gu) expand_weights_kernel<true><<<dim3((1280 * 80 + 255) / 256, b.e1 - b.e0), 256, 0, s>>>(b, g, (__half2*) gu);
+    if (down) expand_weights_kernel<false><<<dim3((2560 * 20 + 255) / 256, b.e1 - b.e0), 256, 0, s>>>(b, g, (__half2*) down);
+}
+void weights_gate_up(const Batch& b, const int32_t* ts, const int2* tiles, const int32_t* off,
+                     int64_t n, int n_expert, int64_t bound, const void* weights,
+                     const uint8_t* act, const int32_t* src, uint8_t* out, cudaStream_t s) {
+    const unsigned grid = (unsigned) std::max<int64_t>(1, bound * GU_NFB);
+    if (pick_bn(n, n_expert) == 128)
+        weights_kernel<true, 128><<<grid, THREADS, 0, s>>>(b, ts, tiles, off, (const uint4*) weights, act, src, out, nullptr);
+    else
+        weights_kernel<true, 64><<<grid, THREADS, 0, s>>>(b, ts, tiles, off, (const uint4*) weights, act, src, out, nullptr);
+}
+void weights_down(const Batch& b, const int32_t* ts, const int2* tiles, const int32_t* off,
+                  int64_t n, int n_expert, int64_t bound, const void* weights,
+                  const uint8_t* h, float* dm, cudaStream_t s) {
+    const unsigned grid = (unsigned) std::max<int64_t>(1, bound * D_NFB);
+    if (pick_bn(n, n_expert) == 128)
+        weights_kernel<false, 128><<<grid, THREADS, 0, s>>>(b, ts, tiles, off, (const uint4*) weights, h, nullptr, nullptr, dm);
+    else
+        weights_kernel<false, 64><<<grid, THREADS, 0, s>>>(b, ts, tiles, off, (const uint4*) weights, h, nullptr, nullptr, dm);
+}
+} // namespace strata::prefill::fused::f16kq
