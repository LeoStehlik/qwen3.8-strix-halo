+// Experimental input staging: the original quantized values were already
+// converted to F16 once. Keep exactly the same LDS layout and matrix inputs.
+template <int BN> struct PreparedActStage {
+    static constexpr int FETCH = BN * 8 / THREADS, STRIDE = BN + 1, BYTES = 2 * 4 * STRIDE * 16;
+    const uint8_t* src[FETCH];
+    int slot[FETCH];
+    uint4 values[FETCH];
+    __device__ __forceinline__ void init(const uint8_t* base, size_t ld, const int* rows, int tid) {
+#pragma unroll
+        for (int i = 0; i < FETCH; ++i) {
+            const int chunk = tid + i * THREADS, t = chunk >> 3, c = chunk & 7;
+            src[i] = rows[t] >= 0 ? base + (size_t) rows[t] * ld + c * 16 : nullptr;
+            slot[i] = c * STRIDE + t;
+        }
+    }
+    __device__ __forceinline__ void fetch(int s) {
+#pragma unroll
+        for (int i = 0; i < FETCH; ++i)
+            values[i] = src[i] ? *reinterpret_cast<const uint4*>(src[i] + (size_t) s * 128)
+                               : make_uint4(0u, 0u, 0u, 0u);
+    }
+    __device__ __forceinline__ void commit(uint4* s_act) const {
+#pragma unroll
+        for (int i = 0; i < FETCH; ++i) s_act[slot[i]] = values[i];
+    }
+};
+
