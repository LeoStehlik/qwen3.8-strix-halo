+// Offline experiment entry points. The serving engine continues to call the
+// unchanged experts_native() path and never allocates these buffers.
+void prepare_act_f16_native(const void* xa, int64_t rows, int cols, void* output, void* stream) {
+#if defined(__HIPCC__)
+    if (cols % 64 != 0 || rows < 0 || !output) std::abort();
+    f16kq::prepare_act((const uint8_t*) xa, output, rows, cols, nullptr, 0, 0, (cudaStream_t) stream);
+    ck(cudaGetLastError(), "prepare_act_f16_native");
+#else
+    (void) xa; (void) rows; (void) cols; (void) output; (void) stream;
+    std::fprintf(stderr, "prepared activation experiment requires HIP gfx11\n");
+    std::abort();
+#endif
+}
+
+void experts_native_prepared(const Batch& b, const NativeGeom& g, int n_expert, int64_t n,
+                            const void* scratch, const void* xa, const void* prepared_x,
+                            const int32_t* src, void* ha, void* prepared_h, float* dm, void* stream) {
+#if defined(__HIPCC__)
+    if (b.e1 <= b.e0 || n <= 0) return;
+    const DevInfo& d = dev_info();
+    if (!d.ok || d.w12 || !f16::requested() || !f16kq::covers(g.gu_type) || !f16kq::covers_down(g.d_type)) {
+        std::fprintf(stderr, "prepared activation experiment requires gfx11 F16 Q4_K/Q5_K with Q5_1 down\n");
+        std::abort();
+    }
+    const cudaStream_t s = (cudaStream_t) stream;
+    const Tables tb = tables(const_cast<void*>(scratch), n_expert);
+    const int64_t bound = (n + kTileRows - 1) / kTileRows + (b.e1 - b.e0);
+    if (prepared_x)
+        f16kq::gate_up_prepared(b, g, tb.ts, tb.tiles, tb.off, n, n_expert, bound,
+                              (const uint8_t*) prepared_x, src, (uint8_t*) ha, s);
+    else
+        f16kq::gate_up(b, g, tb.ts, tb.tiles, tb.off, n, n_expert, bound, (const uint8_t*) xa, src, (uint8_t*) ha, s);
+    if (prepared_h) {
+        f16kq::prepare_act((const uint8_t*) ha, prepared_h, n, 640, tb.off, b.e0, b.e1, s);
+        f16kq::down_prepared(b, g, tb.ts, tb.tiles, tb.off, n, n_expert, bound, (const uint8_t*) prepared_h, dm, s);
+    } else {
+        f16kq::down(b, g, tb.ts, tb.tiles, tb.off, n, n_expert, bound, (const uint8_t*) ha, dm, s);
+    }
+    ck(cudaGetLastError(), "experts_native_prepared");
+#else
+    (void) b; (void) g; (void) n_expert; (void) n; (void) scratch; (void) xa;
+    (void) prepared_x; (void) src; (void) ha; (void) prepared_h; (void) dm; (void) stream;
+    std::fprintf(stderr, "prepared activation experiment requires HIP gfx11\n");
+    std::abort();
+#endif
+}
