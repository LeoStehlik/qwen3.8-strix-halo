+
+void prepare_weights(const Pair& p, const Geo& geo, FusedBufs& b, int E,
+                     const std::vector<const uint8_t*>& blob, cudaStream_t s) {
+    if (!b.weight_gu || (b.weights_ready && !b.prepare_each)) return;
+    const bool first = !b.weights_ready;
+    cudaEvent_t start{}, end{};
+    if (first) {
+        ck(cudaEventCreate(&start), "prepare event"); ck(cudaEventCreate(&end), "prepare event");
+        ck(cudaEventRecord(start, s), "prepare start");
+    }
+    for (int e0 = 0; e0 < E; e0 += fused::kMaxBatch) {
+        fused::Batch bt; bt.e0 = e0; bt.e1 = std::min(E, e0 + fused::kMaxBatch);
+        for (int e = bt.e0; e < bt.e1; ++e) bt.blob[e - bt.e0] = blob[(size_t) e];
+        fused::prepare_weights_compact_native(bt, geo.native(p), b.weight_gu->p, s);
+    }
+    if (first) {
+        ck(cudaEventRecord(end, s), "prepare end"); ck(cudaEventSynchronize(end), "prepare sync");
+        float ms = 0; ck(cudaEventElapsedTime(&ms, start, end), "prepare time");
+        std::printf("  prepared compact weights: %.3f ms, %zu bytes, each-run %d\n", ms,
+                    (size_t) E * 2048000, b.prepare_each ? 1 : 0);
+        ck(cudaEventDestroy(start), "prepare event"); ck(cudaEventDestroy(end), "prepare event");
+    }
+    b.weights_ready = true;
+}
 void run_fused(const Pair& p, const Geo& geo, FusedBufs& b, const float* x_dev, int T, int E,
                const std::vector<int>& cuts, const std::vector<const uint8_t*>& blob, cudaStream_t s) {
     const int64_t rows = (int64_t) T * K;
     const fused::NativeGeom ng = geo.native(p);
+    prepare_weights(p, geo, b, E, blob, s);
